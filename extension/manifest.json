{
  "manifest_version": 3,
  "name": "WebsiteTranslate AI",
  "description": "Prototype Chrome extension for translating English webpages into Hindi.",
  "version": "1.0.0",
  "action": {
    "default_title": "WebsiteTranslate AI",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "scripts/background.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*"
  ]
}
